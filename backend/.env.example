# Copiar este archivo como .env y completar. El .env NO se sube a Git.
SPRING_PROFILES_ACTIVE=dev

# Base local (docker compose)
DB_URL=jdbc:postgresql://localhost:5432/tenis_ahora
DB_USER=tenis
DB_PASSWORD=tenis
# Base en Neon (producción): la URL tiene que terminar en ?sslmode=require
# DB_URL=jdbc:postgresql://<host>.neon.tech/<base>?sslmode=require

# Clave para firmar los JWT: mínimo 32 caracteres, distinta en producción
JWT_SECRET=cambiar-por-una-clave-larga-de-al-menos-32-caracteres

# Orígenes del frontend permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:5173

# Email saliente (dejar vacío en local si no se usa)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Mercado Pago (credenciales de prueba del panel de desarrolladores)
# Access token de la cuenta vendedora DE PRUEBA. Nunca el de una cuenta real ni el de producción.
MP_ACCESS_TOKEN=
# Clave secreta de los webhooks, del mismo panel. Con esto se verifica que el aviso lo manda Mercado Pago.
MP_WEBHOOK_SECRET=
# true con credenciales de prueba: el QR apunta al link de sandbox. En el perfil dev ya viene en true.
MP_SANDBOX=true
